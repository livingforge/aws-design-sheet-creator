{
  "$defs": {
    "Entry": {
      "additionalProperties": false,
      "properties": {
        "action": {
          "enum": [
            "ANSWER",
            "HOLD",
            "READY"
          ],
          "title": "Action",
          "type": "string"
        },
        "ask": {
          "pattern": "^[a-z][a-z0-9_-]{0,63}$",
          "title": "Ask",
          "type": "string"
        },
        "by": {
          "minLength": 1,
          "title": "By",
          "type": "string"
        },
        "note": {
          "default": "",
          "title": "Note",
          "type": "string"
        },
        "on": {
          "format": "date",
          "title": "On",
          "type": "string"
        },
        "option": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Option"
        },
        "value": {
          "$ref": "#/$defs/JsonValue",
          "default": null
        }
      },
      "required": [
        "ask",
        "action",
        "by",
        "on"
      ],
      "title": "Entry",
      "type": "object"
    },
    "JsonValue": {}
  },
  "$id": "aws-design-sheet/ask-records",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "contract": {
      "const": "ask-records/1",
      "title": "Contract",
      "type": "string"
    },
    "entries": {
      "items": {
        "$ref": "#/$defs/Entry"
      },
      "minItems": 1,
      "title": "Entries",
      "type": "array"
    },
    "ledger_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Ledger Sha256",
      "type": "string"
    },
    "recorded_at": {
      "title": "Recorded At",
      "type": "string"
    },
    "sequence": {
      "minimum": 1,
      "title": "Sequence",
      "type": "integer"
    },
    "workbook_sha256": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Workbook Sha256"
    }
  },
  "required": [
    "contract",
    "sequence",
    "ledger_sha256",
    "recorded_at",
    "entries"
  ],
  "title": "Records",
  "type": "object"
}
