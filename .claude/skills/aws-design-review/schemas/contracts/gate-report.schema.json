{
  "$defs": {
    "Gate": {
      "additionalProperties": false,
      "properties": {
        "counts": {
          "additionalProperties": {
            "type": "integer"
          },
          "title": "Counts",
          "type": "object"
        },
        "detail": {
          "default": "",
          "title": "Detail",
          "type": "string"
        },
        "id": {
          "enum": [
            "contracts",
            "source_set",
            "grounding",
            "grounding_self_test",
            "diagram_coverage",
            "service_mentions",
            "overview",
            "generation"
          ],
          "title": "Id",
          "type": "string"
        },
        "items": {
          "items": {
            "additionalProperties": true,
            "type": "object"
          },
          "maxItems": 50,
          "title": "Items",
          "type": "array"
        },
        "status": {
          "enum": [
            "PASS",
            "WARN",
            "FAIL",
            "SKIPPED"
          ],
          "title": "Status",
          "type": "string"
        }
      },
      "required": [
        "id",
        "status"
      ],
      "title": "Gate",
      "type": "object"
    }
  },
  "$id": "aws-design-sheet/gate-report",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "contract": {
      "const": "gate-report/1",
      "title": "Contract",
      "type": "string"
    },
    "gates": {
      "items": {
        "$ref": "#/$defs/Gate"
      },
      "title": "Gates",
      "type": "array"
    },
    "inputs": {
      "additionalProperties": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "null"
          }
        ]
      },
      "title": "Inputs",
      "type": "object"
    },
    "run": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Run"
    },
    "status": {
      "enum": [
        "PASS",
        "WARN",
        "FAIL"
      ],
      "title": "Status",
      "type": "string"
    }
  },
  "required": [
    "contract",
    "status",
    "gates"
  ],
  "title": "GateReport",
  "type": "object"
}
