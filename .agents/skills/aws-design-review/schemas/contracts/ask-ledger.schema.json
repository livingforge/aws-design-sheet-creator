{
  "$defs": {
    "Ask": {
      "additionalProperties": false,
      "properties": {
        "audience": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Audience",
          "type": "array"
        },
        "background": {
          "items": {
            "$ref": "#/$defs/Background"
          },
          "minItems": 1,
          "title": "Background",
          "type": "array"
        },
        "critical": {
          "default": false,
          "description": "go-live depends on it",
          "title": "Critical",
          "type": "boolean"
        },
        "depends_on": {
          "items": {
            "type": "string"
          },
          "title": "Depends On",
          "type": "array"
        },
        "due": {
          "anyOf": [
            {
              "format": "date",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Due"
        },
        "free_value": {
          "anyOf": [
            {
              "$ref": "#/$defs/FreeValue"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "id": {
          "pattern": "^[a-z][a-z0-9_-]{0,63}$",
          "title": "Id",
          "type": "string"
        },
        "kind": {
          "enum": [
            "DECISION",
            "DATA_REQUEST"
          ],
          "title": "Kind",
          "type": "string"
        },
        "only_if": {
          "anyOf": [
            {
              "$ref": "#/$defs/OnlyIf"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "options": {
          "items": {
            "$ref": "#/$defs/Option"
          },
          "title": "Options",
          "type": "array"
        },
        "question": {
          "minLength": 1,
          "title": "Question",
          "type": "string"
        },
        "requirement_conflict": {
          "description": "requirement IDs a current value or option breaks",
          "items": {
            "type": "string"
          },
          "title": "Requirement Conflict",
          "type": "array"
        },
        "settles": {
          "default": "",
          "description": "what the answer decides, in the answerer's words",
          "title": "Settles",
          "type": "string"
        },
        "title": {
          "minLength": 1,
          "title": "Title",
          "type": "string"
        },
        "waits_for": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Waits For"
        }
      },
      "required": [
        "id",
        "kind",
        "title",
        "question",
        "audience",
        "background"
      ],
      "title": "Ask",
      "type": "object"
    },
    "Author": {
      "additionalProperties": false,
      "properties": {
        "actor": {
          "minLength": 1,
          "title": "Actor",
          "type": "string"
        },
        "model": {
          "default": "",
          "title": "Model",
          "type": "string"
        }
      },
      "required": [
        "actor"
      ],
      "title": "Author",
      "type": "object"
    },
    "Background": {
      "additionalProperties": false,
      "properties": {
        "quote": {
          "description": "words the cited cells hold; checked against them",
          "minLength": 1,
          "title": "Quote",
          "type": "string"
        },
        "source": {
          "description": "DOCUMENT_ID#s1-C5 of the cells that say it",
          "minLength": 1,
          "title": "Source",
          "type": "string"
        },
        "text": {
          "minLength": 1,
          "title": "Text",
          "type": "string"
        }
      },
      "required": [
        "text",
        "source",
        "quote"
      ],
      "title": "Background",
      "type": "object"
    },
    "Effect": {
      "additionalProperties": false,
      "properties": {
        "mode": {
          "default": "LITERAL",
          "enum": [
            "LITERAL",
            "OMITTED",
            "DESIGNER_TASK"
          ],
          "title": "Mode",
          "type": "string"
        },
        "property": {
          "description": "setting name, or a path a/0/b into a composite value",
          "minLength": 1,
          "title": "Property",
          "type": "string"
        },
        "resource_id": {
          "pattern": "^[a-z][a-z0-9_-]{0,63}$",
          "title": "Resource Id",
          "type": "string"
        },
        "value": {
          "$ref": "#/$defs/JsonValue",
          "default": null
        }
      },
      "required": [
        "resource_id",
        "property"
      ],
      "title": "Effect",
      "type": "object"
    },
    "FreeValue": {
      "additionalProperties": false,
      "properties": {
        "effects": {
          "description": "settings the answered value goes into; value stays null",
          "items": {
            "$ref": "#/$defs/Effect"
          },
          "title": "Effects",
          "type": "array"
        },
        "hint": {
          "default": "",
          "title": "Hint",
          "type": "string"
        },
        "kind": {
          "enum": [
            "integer",
            "number",
            "string"
          ],
          "title": "Kind",
          "type": "string"
        },
        "maximum": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Maximum"
        },
        "minimum": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Minimum"
        },
        "pattern": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Pattern"
        },
        "unit": {
          "default": "",
          "title": "Unit",
          "type": "string"
        }
      },
      "required": [
        "kind"
      ],
      "title": "FreeValue",
      "type": "object"
    },
    "JsonValue": {},
    "OnlyIf": {
      "additionalProperties": false,
      "properties": {
        "ask": {
          "pattern": "^[a-z][a-z0-9_-]{0,63}$",
          "title": "Ask",
          "type": "string"
        },
        "option": {
          "pattern": "^[a-z0-9]{1,8}$",
          "title": "Option",
          "type": "string"
        }
      },
      "required": [
        "ask",
        "option"
      ],
      "title": "OnlyIf",
      "type": "object"
    },
    "Option": {
      "additionalProperties": false,
      "properties": {
        "effects": {
          "items": {
            "$ref": "#/$defs/Effect"
          },
          "title": "Effects",
          "type": "array"
        },
        "follow_up": {
          "items": {
            "type": "string"
          },
          "title": "Follow Up",
          "type": "array"
        },
        "id": {
          "pattern": "^[a-z0-9]{1,8}$",
          "title": "Id",
          "type": "string"
        },
        "impact": {
          "minLength": 1,
          "title": "Impact",
          "type": "string"
        },
        "label": {
          "minLength": 1,
          "title": "Label",
          "type": "string"
        },
        "proposed": {
          "default": false,
          "title": "Proposed",
          "type": "boolean"
        }
      },
      "required": [
        "id",
        "label",
        "impact"
      ],
      "title": "Option",
      "type": "object"
    }
  },
  "$id": "aws-design-sheet/ask-ledger",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "asks": {
      "items": {
        "$ref": "#/$defs/Ask"
      },
      "minItems": 1,
      "title": "Asks",
      "type": "array"
    },
    "author": {
      "anyOf": [
        {
          "$ref": "#/$defs/Author"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "contract": {
      "const": "ask-ledger/1",
      "title": "Contract",
      "type": "string"
    }
  },
  "required": [
    "contract",
    "asks"
  ],
  "title": "Ledger",
  "type": "object"
}
