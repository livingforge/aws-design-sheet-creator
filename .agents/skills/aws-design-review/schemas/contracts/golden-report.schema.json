{
  "$defs": {
    "CaseResult": {
      "additionalProperties": false,
      "properties": {
        "agreement": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Agreement"
        },
        "detail": {
          "default": "",
          "title": "Detail",
          "type": "string"
        },
        "differences": {
          "items": {
            "additionalProperties": true,
            "type": "object"
          },
          "maxItems": 50,
          "title": "Differences",
          "type": "array"
        },
        "id": {
          "title": "Id",
          "type": "string"
        },
        "kind": {
          "title": "Kind",
          "type": "string"
        },
        "status": {
          "enum": [
            "PASS",
            "FAIL",
            "MISSING",
            "INVALID"
          ],
          "title": "Status",
          "type": "string"
        }
      },
      "required": [
        "id",
        "kind",
        "status"
      ],
      "title": "CaseResult",
      "type": "object"
    }
  },
  "$id": "aws-design-sheet/golden-report",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "candidate": {
      "title": "Candidate",
      "type": "string"
    },
    "cases": {
      "items": {
        "$ref": "#/$defs/CaseResult"
      },
      "title": "Cases",
      "type": "array"
    },
    "contract": {
      "const": "golden-report/1",
      "title": "Contract",
      "type": "string"
    },
    "manifest_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Manifest Sha256",
      "type": "string"
    },
    "rules": {
      "additionalProperties": {
        "enum": [
          "PASS",
          "FAIL"
        ],
        "type": "string"
      },
      "title": "Rules",
      "type": "object"
    },
    "status": {
      "enum": [
        "PASS",
        "FAIL"
      ],
      "title": "Status",
      "type": "string"
    }
  },
  "required": [
    "contract",
    "manifest_sha256",
    "candidate",
    "status",
    "cases"
  ],
  "title": "GoldenReport",
  "type": "object"
}
