{
  "$id": "aws-design-sheet/external-review",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "actor": {
      "minLength": 1,
      "title": "Actor",
      "type": "string"
    },
    "decision": {
      "enum": [
        "accepted",
        "rejected"
      ],
      "title": "Decision",
      "type": "string"
    },
    "items_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Items Sha256",
      "type": "string"
    },
    "reason": {
      "minLength": 1,
      "title": "Reason",
      "type": "string"
    },
    "recorded_at": {
      "title": "Recorded At",
      "type": "string"
    },
    "schema_version": {
      "const": "1",
      "title": "Schema Version",
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "items_sha256",
    "decision",
    "actor",
    "reason",
    "recorded_at"
  ],
  "title": "Review",
  "type": "object"
}
