{
  "$id": "aws-design-sheet/diagram-review",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "actor": {
      "minLength": 1,
      "title": "Actor",
      "type": "string"
    },
    "author": {
      "minLength": 1,
      "title": "Author",
      "type": "string"
    },
    "contract": {
      "const": "diagram-review/1",
      "title": "Contract",
      "type": "string"
    },
    "decision": {
      "enum": [
        "accepted",
        "rejected"
      ],
      "title": "Decision",
      "type": "string"
    },
    "ledger_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Ledger Sha256",
      "type": "string"
    },
    "reason": {
      "minLength": 1,
      "title": "Reason",
      "type": "string"
    },
    "recorded_at": {
      "title": "Recorded At",
      "type": "string"
    }
  },
  "required": [
    "contract",
    "ledger_sha256",
    "decision",
    "actor",
    "author",
    "reason",
    "recorded_at"
  ],
  "title": "LedgerReview",
  "type": "object"
}
